# Optional local settings. Copy this file to .env to override the defaults.

# PostgreSQL and PostGIS. Keep DATABASE_URL in sync with the Compose settings.
POSTGRES_USER=yatirimradar
POSTGRES_PASSWORD=yatirimradar
POSTGRES_DB=yatirimradar
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://yatirimradar:yatirimradar@localhost:5432/yatirimradar

# Optional API key reserved for document extraction.
ANTHROPIC_API_KEY=

# HTTP requests
HTTP_USER_AGENT=YatirimRadar/0.1
REQUEST_DELAY_SECONDS=2.0

# Geocoding and default region
GEOCODE_CONFIDENCE_THRESHOLD=0.7
PILOT_IL=Ankara
PILOT_ILCE=Polatlı

# Set an absolute path to use a different directory for assessment CSV files.
# RAYIC_DIZINI=

LOG_LEVEL=INFO
